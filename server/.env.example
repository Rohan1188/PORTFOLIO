# Local: MongoDB Compass / mongod.   Production: your Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
PORT=4000
NODE_ENV=development
# Origin(s) of the React app, comma separated (used for CORS + CSRF origin check)
CLIENT_ORIGIN=http://localhost:5173
# Long random string used to HMAC visitor IPs. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=change-me
