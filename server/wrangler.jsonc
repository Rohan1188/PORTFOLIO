{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rohan-portfolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],

  // React build produced by `npm run build` in ../client
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/sitemap.xml", "/robots.txt"]
  },

  "durable_objects": { "bindings": [{ "name": "API_DO", "class_name": "ApiDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiDO"] }],

  // Create first:  wrangler r2 bucket create portfolio-media   |   wrangler kv namespace create RATE_LIMIT
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "portfolio-media" }],
  "kv_namespaces": [{ "binding": "RATE_LIMIT", "id": "REPLACE_WITH_KV_ID" }],

  // Non-secret config. Secrets: wrangler secret put MONGODB_URI / IP_HASH_SECRET
  "vars": { "NODE_ENV": "production", "CLIENT_ORIGIN": "https://YOUR-DOMAIN", "PUBLIC_URL": "https://YOUR-DOMAIN" }
}
